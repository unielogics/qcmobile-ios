{
  "expo": {
    "name": "Qualified Commercial",
    "slug": "qcmobile-ios",
    "scheme": "qcmobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qualifiedcommercial.mobile",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Qualified Commercial uses your camera to scan HUD-1s, closing docs, and property photos for upload to your investor profile.",
        "NSPhotoLibraryUsageDescription": "Qualified Commercial reads your photo library so you can pick existing closing docs and property images to upload to your loan files.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.qualifiedcommercial.mobile"
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Qualified Commercial uses your camera to scan HUD-1s, closing docs, and property photos.",
          "photosPermission": "Qualified Commercial reads your photo library so you can pick existing closing docs and property images.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B1D3A",
          "defaultChannel": "default",
          "androidMode": "default",
          "androidCollapsedTitle": "Qualified Commercial"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://api.qualifiedcommercial.com",
      "router": {},
      "eas": {
        "projectId": "be1cda04-555c-4f51-b293-a22dcecb07a7"
      }
    },
    "owner": "qualifiedcommercial"
  }
}
